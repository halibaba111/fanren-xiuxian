      "ad_type": "double_reward",
      "ad_placement": "reward_double_qi05",
      "dialogue_before": "铜灯碎片、黑根样本和觉醒铜灯已经放进存档。",
      "ad_reward_text": "完整观看广告后，本次结算道具数量翻倍。",
